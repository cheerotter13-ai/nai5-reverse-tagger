# OpenAI-compatible vision Chat Completions.
# BASE: stop at /v1. Do not append /chat/completions.
# MODEL: a vision-capable model on that API.
# KEY: Bearer token if the API requires auth; leave empty if it does not.
NAI5_TAGGER_VLM_BASE=https://api.openai.com/v1
NAI5_TAGGER_VLM_MODEL=gpt-4o
NAI5_TAGGER_VLM_KEY=
# Optional WD14 folder with model.onnx and selected_tags.csv
NAI5_TAGGER_WD14_DIR=
